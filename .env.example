DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/chat_quota?schema=public"

NODE_ENV=development
PORT=3000

AUTH_ISSUER_URL=https://YOUR-TENANT.us.auth0.com/
AUTH_AUDIENCE=https://chat-quota-api

CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=10000
BODY_LIMIT=10kb
NONCE_WINDOW_SECONDS=300

MOCK_AI_MIN_LATENCY_MS=300
MOCK_AI_MAX_LATENCY_MS=1200
PAYMENT_FAILURE_RATE=0.2

# Only used by the local helper scripts in scripts/, never by the server
TEST_CLIENT_ID=CHANGE_ME
TEST_CLIENT_SECRET=CHANGE_ME